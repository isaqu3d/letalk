{
  "name": "letalk",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma de enriquecimento de leads a partir de CNPJ — teste técnico Letalk",
  "type": "module",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @letalk/api dev",
    "dev:web": "pnpm --filter @letalk/web dev",
    "db:migrate": "pnpm --filter @letalk/api db:migrate",
    "db:generate": "pnpm --filter @letalk/api db:generate",
    "db:studio": "pnpm --filter @letalk/api db:studio",
    "db:reset": "pnpm --filter @letalk/api db:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
