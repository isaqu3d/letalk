generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String
  phone         String
  cnpj          String
  contactRole   String?
  segment       String
  employeeRange String
  createdAt     DateTime @default(now())

  razaoSocial     String
  nomeFantasia    String?
  cnaePrincipal   String?
  cnaeDescription String?
  capitalSocial   Float?
  porte           String?
  situacao        String?
  dataAbertura    DateTime?

  logradouro   String?
  numero       String?
  complemento  String?
  bairro       String?
  municipio    String?
  uf           String?
  cep          String?
  socios       Json?

  @@unique([email, cnpj])
  @@index([cnpj])
  @@index([createdAt])
  @@map("leads")
}
